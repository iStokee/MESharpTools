<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MESharpNavTool</AssemblyName>
    <!-- Self-registration for ToolRelease.ps1 auto-discovery + the umbrella manifest. -->
    <IsMESharpTool>true</IsMESharpTool>
    <MESharpToolDisplayName>Navigation</MESharpToolDisplayName>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- English-only keeps satellite resource folders out of bin so the xcopy deploy stays clean. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="FodyWeavers.xml" />
  </ItemGroup>

  <!--
    Costura embeds MESharp.Tooling, MahApps, IconPacks and the managed WebView2 assemblies into the
    script DLL so the scripts folder stays self-contained. csharp_interop is excluded (FodyWeavers.xml)
    because ME loads it from Build_DLL and a second copy breaks hot reload (DUPLICATE_ASSEMBLY_FIX.md).
  -->
  <ItemGroup>
    <PackageReference Include="Costura.Fody" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.9.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="MahApps.Metro.IconPacks" Version="6.1.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MESharp.Tooling\MESharp.Tooling.csproj" />
    <ProjectReference Include="..\..\MESharp.CacheDerivation\MESharp.CacheDerivation.csproj" />
    <ProjectReference Include="..\..\csharp_interop\csharp_interop.csproj" />
    <ProjectReference Include="..\..\ME_CSharp_Scripts\SharpSlayer\MESharp.Slayer\MESharp.Slayer.csproj" />
  </ItemGroup>

  <!-- Embed the coverage map page so CoverageMapServer can serve it regardless of run location. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\tools\webwalk_map\index.html" Link="webwalk_map\index.html" LogicalName="MESharp.webwalk_map.index.html" />
    <!-- Native P/Invoke loader for live-update installs, which otherwise receive only this tool DLL. -->
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" LogicalName="MESharp.WebView2Loader.x64.dll" />
  </ItemGroup>

  <!--
    Deploy only the woven script DLL. Dependencies and the extract-on-use x64 WebView2 native loader
    are embedded. Never copy the whole TargetDir: a stray csharp_interop.dll in the scripts folder
    breaks hot reload (DUPLICATE_ASSEMBLY_FIX.md).
  -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(SkipDeployToMe)' != 'true'">
    <PropertyGroup>
      <ToolDeployRoot Condition="'$(ToolDeployRoot)' == ''">$(USERPROFILE)\MemoryError\CSharp_scripts\tools</ToolDeployRoot>
      <ToolDeployDir>$(ToolDeployRoot)\$(AssemblyName)\</ToolDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(ToolDeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ToolDeployDir)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ToolDeployDir)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <WriteLinesToFile File="$(ToolDeployDir)tool.json" Overwrite="true" Lines="{ &quot;displayName&quot;: &quot;$(MESharpToolDisplayName)&quot;, &quot;assetName&quot;: &quot;$(TargetFileName)&quot;, &quot;version&quot;: &quot;$(AssemblyVersion)&quot;, &quot;updateUrl&quot;: &quot;https://github.com/iStokee/MESharpTools/releases/latest/download/$(AssemblyName).tool.json&quot; }" />
  </Target>
</Project>
