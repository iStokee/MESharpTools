<UserControl x:Class="MESharp.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:MESharp.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <!-- WebView2 host (control is created in code-behind so init failures degrade gracefully) -->
        <Border x:Name="WebHostBorder"
                Background="{DynamicResource App.CardBrush}" CornerRadius="6" ClipToBounds="True">
            <Grid x:Name="WebHost" />
        </Border>

        <!-- Fallback when WebView2 is unavailable -->
        <Border Background="{DynamicResource App.CardBrush}" CornerRadius="6" Padding="24"
                Visibility="{Binding WebViewFailed, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                <iconPacks:PackIconMaterial Kind="WebOff" Width="40" Height="40" HorizontalAlignment="Center"
                                            Foreground="{DynamicResource App.MutedBrush}" Margin="0,0,0,12" />
                <TextBlock Text="The embedded map could not start." FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource App.ForegroundBrush}" />
                <TextBlock Text="{Binding WebViewError}" Margin="0,8,0,12" TextWrapping="Wrap"
                           Foreground="{DynamicResource App.SubtleForegroundBrush}" FontSize="12" />
                <TextBlock Text="Install the Microsoft Edge WebView2 Runtime (Evergreen), or use the external browser instead — same live map, same tools."
                           TextWrapping="Wrap" Foreground="{DynamicResource App.SubtleForegroundBrush}" FontSize="12" Margin="0,0,0,12" />
                <Button Command="{Binding OpenInBrowserCommand}" HorizontalAlignment="Center" Padding="14,6" Content="Open Map in Browser" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
