<UserControl x:Class="MESharp.SlayerKnowledgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Slayer Knowledge" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Curate assignments, master pools, locations, mechanics, and evidence. Route actions remain owned by Navigation." Foreground="{DynamicResource MahApps.Brushes.Gray}"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" Padding="14,7"/><Button Content="Publish knowledge pack" Command="{Binding PublishCommand}" Padding="14,7" Background="{DynamicResource MahApps.Brushes.Accent}" Foreground="White"/></StackPanel>
        </Grid>
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,14,0,12">
            <GroupBox Header="Monsters" Margin="0,0,6,0"><TextBlock Text="{Binding MonsterCount}" FontSize="22" Margin="10"/></GroupBox>
            <GroupBox Header="Assignments" Margin="0,0,6,0"><TextBlock Text="{Binding AssignmentCount}" FontSize="22" Margin="10"/></GroupBox>
            <GroupBox Header="Masters" Margin="0,0,6,0"><TextBlock Text="{Binding MasterCount}" FontSize="22" Margin="10"/></GroupBox>
            <GroupBox Header="Locations" Margin="0,0,6,0"><TextBlock Text="{Binding LocationCount}" FontSize="22" Margin="10"/></GroupBox>
            <GroupBox Header="Runnable"><TextBlock Text="{Binding RunnableLocationCount}" FontSize="22" Margin="10"/></GroupBox>
        </UniformGrid>
        <TabControl Grid.Row="2">
            <TabItem Header="Assignments &amp; monsters">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <DataGrid Grid.Column="0" ItemsSource="{Binding Assignments}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,8,4,0"><DataGrid.Columns><DataGridTextColumn Header="Assignment" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Stable ID" Binding="{Binding Id}" Width="2*"/><DataGridTextColumn Header="Slayer" Binding="{Binding Requirements.MinimumSlayerLevel}" Width="70"/></DataGrid.Columns></DataGrid>
                    <DataGrid Grid.Column="1" ItemsSource="{Binding Monsters}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="4,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Monster" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Weakness" Binding="{Binding Weakness}" Width="*"/><DataGridTextColumn Header="Combat" Binding="{Binding CombatLevel}" Width="70"/><DataGridTextColumn Header="Slayer" Binding="{Binding SlayerLevel}" Width="70"/></DataGrid.Columns></DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Master pools">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Masters}" SelectedItem="{Binding SelectedMaster}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,8,4,0"><DataGrid.Columns><DataGridTextColumn Header="Master" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Acquisition" Binding="{Binding Acquisition}" Width="90"/><DataGridTextColumn Header="Task" Binding="{Binding PointsPerTask}" Width="50"/><DataGridTextColumn Header="10th" Binding="{Binding PointsPerTenthTask}" Width="50"/><DataGridTextColumn Header="50th" Binding="{Binding PointsPerFiftiethTask}" Width="50"/><DataGridCheckBoxColumn Header="Wild" Binding="{Binding IsWildernessMaster}" Width="50"/></DataGrid.Columns></DataGrid>
                    <DataGrid Grid.Column="1" ItemsSource="{Binding SelectedMasterRules}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="4,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Assignment ID" Binding="{Binding AssignmentId}" Width="2*"/><DataGridTextColumn Header="Weight" Binding="{Binding Weight}" Width="70"/><DataGridTextColumn Header="Min" Binding="{Binding MinimumQuantity}" Width="65"/><DataGridTextColumn Header="Max" Binding="{Binding MaximumQuantity}" Width="65"/><DataGridTextColumn Header="Toggle / unlock" Binding="{Binding UnlockOrToggle}" Width="*"/><DataGridCheckBoxColumn Header="Default" Binding="{Binding EnabledByDefault}" Width="65"/><DataGridComboBoxColumn Header="Verification" SelectedItemBinding="{Binding Verification}" ItemsSource="{Binding DataContext.VerificationOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="110"/></DataGrid.Columns></DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Locations">
                <Grid><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,8,0,4"><DataGrid.Columns><DataGridTextColumn Header="Location" Binding="{Binding Name}" Width="1.4*"/><DataGridTextColumn Header="Assignment ID" Binding="{Binding AssignmentId}" Width="1.6*"/><DataGridTextColumn Header="Area ID" Binding="{Binding AreaId}" Width="1.5*"/><DataGridTextColumn Header="Dungeon ID" Binding="{Binding DungeonId}" Width="1.2*"/><DataGridTextColumn Header="Map" Binding="{Binding MapId}" Width="65"/><DataGridTextColumn Header="Plane" Binding="{Binding Plane}" Width="60"/><DataGridComboBoxColumn Header="Verification" SelectedItemBinding="{Binding Verification}" ItemsSource="{Binding DataContext.VerificationOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="120"/><DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="70"/></DataGrid.Columns></DataGrid>
                    <GroupBox Grid.Row="1" Header="Selected location evidence" Margin="0,4,0,0"><DataGrid ItemsSource="{Binding SelectedLocationEvidence}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Source" Binding="{Binding SourceKind}" Width="1.2*"/><DataGridTextColumn Header="Page / ID" Binding="{Binding SourceId}" Width="1.4*"/><DataGridTextColumn Header="Revision" Binding="{Binding SourceRevision}" Width="80"/><DataGridTextColumn Header="Verification" Binding="{Binding Verification}" Width="100"/><DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="2*"/></DataGrid.Columns></DataGrid></GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="Mechanics"><DataGrid ItemsSource="{Binding Mechanics}" AutoGenerateColumns="False" CanUserAddRows="True" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.2*"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/><DataGridTextColumn Header="Automation" Binding="{Binding AutomationState}" Width="1.2*"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="Unknown assignment IDs"><DataGrid ItemsSource="{Binding AssignmentObservations}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Live ID" Binding="{Binding LiveAssignmentId}" Width="80"/><DataGridTextColumn Header="Assignment ID" Binding="{Binding AssignmentId}" Width="1.2*"/><DataGridTextColumn Header="Observed" Binding="{Binding ObservedAtUtc}" Width="160"/><DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="2*"/></DataGrid.Columns></DataGrid></TabItem>
        </TabControl>
        <DockPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding KnowledgePath}" Foreground="{DynamicResource MahApps.Brushes.Gray}"/><TextBlock Text="{Binding Status}"/></DockPanel>
    </Grid>
</UserControl>
